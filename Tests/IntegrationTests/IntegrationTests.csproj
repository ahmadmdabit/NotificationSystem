<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<IsPackable>false</IsPackable>
		<TUnitImplicitUsings>false</TUnitImplicitUsings>
		<TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit" Version="1.69.0" />
		<!-- Real-broker tests need the RabbitMQ transport. Same package and version already
		     used by both service Infrastructure projects; added here because Shared.Infrastructure
		     references MassTransit but not the transport. -->
		<PackageReference Include="MassTransit.RabbitMQ" Version="8.5.10" />
	</ItemGroup>

	<ItemGroup>
		<!-- Brings MassTransit, DomainEvent, and MassTransitDomainEventDispatcher
		     (the component under guard). -->
		<ProjectReference Include="..\..\Shared\Shared.Infrastructure\Shared.Infrastructure.csproj" />
		<!-- Reuses the existing TestDomainEvent / TestDomainEventFactory rather than
		     declaring a parallel event type. -->
		<ProjectReference Include="..\UnitTests\TestDoubles\TestDoubles.csproj" />
	</ItemGroup>

</Project>
