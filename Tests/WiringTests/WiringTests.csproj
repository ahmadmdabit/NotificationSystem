<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<IsPackable>false</IsPackable>
		<TUnitImplicitUsings>false</TUnitImplicitUsings>
		<TUnitAssertionsImplicitUsings>false</TUnitAssertionsImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TUnit" Version="1.69.0" />
		<PackageReference Include="TUnit.AspNetCore" Version="1.69.0" />
		<PackageReference Include="TUnit.Mocks" Version="1.69.0" />
		<PackageReference Include="TUnit.Mocks.Assertions" Version="1.69.0" />
		<PackageReference Include="TUnit.Mocks.Logging" Version="1.69.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Services\UserService\UserService.Application\UserService.Application.csproj" />
		<ProjectReference Include="..\..\Services\UserService\UserService.Infrastructure\UserService.Infrastructure.csproj" />
		<ProjectReference Include="..\..\Services\NotificationService\NotificationService.Application\NotificationService.Application.csproj" />
		<ProjectReference Include="..\..\Services\NotificationService\NotificationService.Infrastructure\NotificationService.Infrastructure.csproj" />
		<ProjectReference Include="..\..\Services\UserService\UserService.Api\UserService.Api.csproj" />
		<ProjectReference Include="..\..\Services\NotificationService\NotificationService.Api\NotificationService.Api.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Required for AddExceptionHandler<T>() / AddControllers(), which the
		     R-16 API-registration guard mirrors from each Program.cs. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

</Project>
