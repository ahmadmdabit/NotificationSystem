<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- ApiController.ForwardAsync and GatewayApiClient's client-factory seam are internal
	     specifically so they can be unit tested. This is an item, not a property; it needs
	     GenerateAssemblyInfo (default true). -->
	<ItemGroup>
		<InternalsVisibleTo Include="UI.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="RestSharp" Version="114.0.0" />
		<PackageReference Include="RestSharp.Serializers.NewtonsoftJson" Version="114.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Shared\Shared.Api\Shared.Api.csproj" />
	</ItemGroup>

</Project>
