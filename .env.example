# SQL Server (required)
SQL_SA_PASSWORD=

# Shared JWT signing key for UserService and NotificationService (openssl rand -hex 64)
JWT_SECRET=

# Password for the UI BFF service account (registered on first authenticated call)
UI_SERVICE_PASSWORD=

# Messaging (optional — in-memory by default)
# Set UseRabbitMq=true to enable RabbitMQ transport.
# NOTE: docker-compose.yml injects UseRabbitMq=true + Host=rabbitmq for the services;
# the localhost/guest values below apply only when running the APIs locally.
Messaging__UseRabbitMq=false
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__Username=guest
Messaging__RabbitMq__Password=guest

# Run the bus, or drop domain events instead of publishing them.
#
# MassTransit is pinned to 8.5.10 in both *.Infrastructure.csproj, which needs NO licence key.
# An earlier pin was 9.2.2, which is commercially licensed and refused to create a bus without
# one — including for the in-memory transport, because the gate ran at bus creation before the
# transport was chosen. That is why this switch exists at all, and it is worth keeping: it is the
# only way to run the stack with no broker and no publishing at all.
#
# Default is ON, because nothing needs a licence key at the current pin.
#
#   false  -> no bus is registered; NullDomainEventDispatcher drops domain events and logs it.
#             Events are DISCARDED, not queued. Fine for local dev and CI, not a deployment mode.
#
# Naming: the two variables are not interchangeable.
#   MESSAGING_ENABLED  is the compose interpolation variable - set THIS one here.
#   Messaging__Enabled is the ASP.NET Core configuration key inside the container. Compose sets
#                      it from MESSAGING_ENABLED, so a value here is ignored for the containers.
#                      Export it yourself only when running an API directly with `dotnet run`.
#                      Setting only the latter leaves messaging ON in the containers.
MESSAGING_ENABLED=true

# RabbitMQ broker credentials, REQUIRED for `docker compose up`. Compose declares both as
# required, so an empty value fails interpolation before any container starts and the error names
# the variable rather than anything about your code.
# The default 'guest' account is loopback-only and is REFUSED for remote (bridge-network)
# connections, so compose requires a non-default pair — create any non-guest pair:
#   RABBITMQ_USER=app
#   RABBITMQ_PASSWORD=$(openssl rand -hex 16)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
