# SQL Server (required)
SQL_SA_PASSWORD=

# Shared JWT signing key for UserService and NotificationService (openssl rand -hex 64)
JWT_SECRET=

# Password for the UI BFF service account (registered on first authenticated call)
UI_SERVICE_PASSWORD=

# Messaging (optional — in-memory by default)
# Set UseRabbitMq=true to enable RabbitMQ transport.
# NOTE: docker-compose.yml injects UseRabbitMq=true + Host=rabbitmq for the services;
# the localhost/guest values below apply only when running the APIs locally.
Messaging__UseRabbitMq=false
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__Username=guest
Messaging__RabbitMq__Password=guest

# MassTransit 9.x (pinned in both *.Infrastructure.csproj) is COMMERCIALLY LICENSED and throws
# ConfigurationException at bus creation without a key. The gate runs BEFORE transport selection,
# so the in-memory transport above is NOT a licence-free path and UseRabbitMq=false does not help.
# There is no development, CI or test exemption.
#
# The key is read from a FILE. It is deliberately absent from this template: do not add a value
# here, and never place the key in a Dockerfile, ARG, ENV or appsettings. Put the file at
#   ~/.dotnet/MassTransit/license.txt
# or point MASSTRANSIT_LICENSE_FILE elsewhere. docker-compose.yml mounts it read-only at
# /masstransit/license.txt and sets MT_LICENSE_PATH to that path.
#
# To run with NO licence at all (local dev, CI), set MESSAGING_ENABLED - NOT Messaging__Enabled.
# docker-compose.yml sets Messaging__Enabled itself from MESSAGING_ENABLED, so a
# Messaging__Enabled value in this file is IGNORED for the containers. The two names are not
# interchangeable: Messaging__Enabled is the ASP.NET Core configuration key (correct when you
# `dotnet run` an API directly and export it); MESSAGING_ENABLED is the compose interpolation
# variable (correct here). Setting only the former gives you messaging ON in the containers and
# a MassTransit.ConfigurationException crash-loop.                                     (N-08)
MESSAGING_ENABLED=false

# Compose bind-mounts the licence path unconditionally, so create the file before the first
# `up`. If the host path does not exist Docker creates a DIRECTORY there, and the mount then
# fails with a confusing error instead of the documented "License must be specified". This only
# matters when messaging is ON; with MESSAGING_ENABLED=false the file is never read.        (N-09)
#   mkdir -p ~/.dotnet/MassTransit && touch ~/.dotnet/MassTransit/license.txt

# RabbitMQ broker credentials for docker compose (required when Messaging__UseRabbitMq=true).
# The default 'guest' account is loopback-only and is REFUSED for remote (bridge-network)
# connections, so compose requires non-default credentials — create any non-guest pair:
#   RABBITMQ_USER=app
#   RABBITMQ_PASSWORD=$(openssl rand -hex 16)
RABBITMQ_USER=
RABBITMQ_PASSWORD=
