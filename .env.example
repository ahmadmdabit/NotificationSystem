# SQL Server (required)
SQL_SA_PASSWORD=

# Shared JWT signing key for UserService and NotificationService (openssl rand -hex 32)
JWT_SECRET=

# Password for the UI BFF service account (registered on first authenticated call)
UI_SERVICE_PASSWORD=

# Messaging (optional — in-memory by default)
# Set UseRabbitMq=true to enable RabbitMQ transport
Messaging__UseRabbitMq=false
Messaging__RabbitMq__Host=localhost
Messaging__RabbitMq__Username=guest
Messaging__RabbitMq__Password=guest
